//      cmm="Pressure Field (Pa) - uMax=" + uMax + ", Mu=" + Mu,
//      ps="snspressure.eps");

// // 2. 速度矢量场 - 平面版
// plot([ux, uy], 
//      coef=0.08,               // 调整箭头大小
//      wait=true,
//      aspectratio=1,
//      bb=[[0,5],[0,1]],
//      cmm="Velocity Field (m/s) - uMax=" + uMax + ", Mu=" + Mu,
//      ps="snsvelocity.eps");

// // 3. 速度大小分布 - 平面版
// Ph velocitymagnitude = sqrt(ux^2 + uy^2);
// plot(velocitymagnitude, 
//      fill=true, 
//      value=true, 
//      nbiso=20,
//      wait=true,
//      aspectratio=1,
//      bb=[[0,5],[0,1]],
//      cmm="Velocity Magnitude (m/s) - uMax=" + uMax + ", Mu=" + Mu,
//      ps="snsvelocitymagnitude.eps");

// // 4. 计算网格 - 平面版
// plot(Th, 
//      wait=true,
//      aspectratio=1,
//      bb=[[0,5],[0,1]],
//      cmm="Computational Mesh - Elements: " + Th.nt + ", Vertices: " + Th.nv,
//      ps="snsmesh.eps");

// 5. 流线图 - 平面版
// 计算流函数用于绘制流线
fespace Psih(Th, P2);
Psih psi, v;
solve StreamFunction(psi, v) = 
    int2d(Th)(dx(psi)*dx(v) + dy(psi)*dy(v))
    + int2d(Th)(uy*dx(v) - ux*dy(v))
    + on(Wall, Inlet, Outlet, psi=0);

if (figPrefix != "") {
    real vmax = velmagmax;
    real arrowcoef = (vmax > 1e-10) ? min(1.0, max(0.05, 0.3/vmax)) : 0.3;
    if (pZmax > pZmin) {
        real[int] pViso(21);
        for (int i = 0; i < pViso.n; i++) {
            pViso[i] = pZmin + (pZmax - pZmin) * i / (pViso.n - 1);
        }
        plot(p,
             wait=false,
             fill=true,
             value=false,
             nbiso=20,
             viso=pViso,
             NbColors=64,
             NbColorTicks=6,
             ColorScheme=1,
             ShowAxes=false,
             ps=figPrefix + "_pressure.eps",
             cmm="");
    } else {
        plot(p,
             wait=false,
             fill=true,
             value=false,
             nbiso=20,
             NbColors=64,
             NbColorTicks=6,
             ColorScheme=1,
             ShowAxes=false,
             ps=figPrefix + "_pressure.eps",
             cmm="");
    }
    if (vZmax > vZmin) {
        real[int] vViso(21);
        for (int i = 0; i < vViso.n; i++) {
            vViso[i] = vZmin + (vZmax - vZmin) * i / (vViso.n - 1);
        }
        plot(velocitymagnitude,
             wait=false,
             fill=true,
             value=false,
             nbiso=20,
             viso=vViso,
             NbColors=64,
             NbColorTicks=6,
             ColorScheme=1,
             ShowAxes=false,
             ps=figPrefix + "_velmag.eps",
             cmm="");
    } else {
        plot(velocitymagnitude,
             wait=false,
             fill=true,
             value=false,
             nbiso=20,
             NbColors=64,
             NbColorTicks=6,
             ColorScheme=1,
             ShowAxes=false,
             ps=figPrefix + "_velmag.eps",
             cmm="");
    }
    if (figMode == "full") {
        plot([ux, uy],
             wait=false,
             coef=arrowcoef,
             value=false,
             ps=figPrefix + "_velocity.eps",
             cmm="Velocity field - uMax=" + uMax + ", Mu=" + Mu);
        plot(psi,
             wait=false,
             nbiso=15,
             ps=figPrefix + "_streamlines.eps",
             cmm="Streamlines - uMax=" + uMax + ", Mu=" + Mu);
    }
}

